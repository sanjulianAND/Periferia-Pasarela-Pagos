{
  "name": "perxia-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/domain/checkout.test.ts src/api/app.test.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "hono": "^4.10.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.1"
  }
}
